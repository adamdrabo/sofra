meta {
  name: 14 Mon compte, avec session
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/auth/moi
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{jeton}}
}

assert {
  res.status: eq 200
}

tests {
  test("le compte renvoye est bien celui du jeton", function() {
    expect(res.getBody().compte.courriel).to.equal(bru.getVar("courrielTest"));
  });
}

docs {
  L'application appelle cette adresse au demarrage pour savoir si le
  jeton enregistre sur l'appareil est encore valide.
}
